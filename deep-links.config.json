{
  "appName": "Trade App",
  "environments": [
    {
      "key": "sit",
      "label": "SIT",
      "schemeEnabled": true,
      "schemeHost": "tradeapp",
      "schemePrefix": "tradeapp",
      "webHost": "accstorefront.crre-fletcherb1-s3-public.model-t.cc.commerce.ondemand.com",
      "webBasePath": "/tradeapp",
      "notes": "Use for QA unless a test case explicitly says otherwise."
    },
    {
      "key": "uat",
      "label": "UAT",
      "schemeEnabled": true,
      "schemeHost": "tradeapp",
      "schemePrefix": "tradeapp",
      "webHost": "accstorefront.crre-fletcherb1-s3-public.model-t.cc.commerce.ondemand.com",
      "webBasePath": "/tradeapp",
      "notes": "Same routing format as SIT."
    },
    {
      "key": "prod",
      "label": "PROD",
      "schemeEnabled": false,
      "webHost": "www.placemakers.co.nz",
      "webBasePath": "/redirect",
      "notes": "Use the production HTTPS route only."
    }
  ],
  "routes": [
    {
      "key": "dashboard",
      "label": "Dashboard",
      "description": "Main dashboard",
      "pathTemplate": ""
    },
    {
      "key": "orders",
      "label": "Order list view",
      "description": "Orders list",
      "pathTemplate": "/orders"
    },
    {
      "key": "order-details",
      "label": "Order details",
      "description": "Order details",
      "pathTemplate": "/orders/{orderId}",
      "params": [
        {
          "key": "orderId",
          "label": "Order ID",
          "placeholder": "123456",
          "required": true
        }
      ]
    },
    {
      "key": "order-messages",
      "label": "Order management messages",
      "description": "Order details with Messages tab selected",
      "pathTemplate": "/orders/{orderId}?tab=messages",
      "params": [
        {
          "key": "orderId",
          "label": "Order ID",
          "placeholder": "123456",
          "required": true
        }
      ]
    },
    {
      "key": "reorder",
      "label": "Re-order",
      "description": "Start a re-order flow from an order number",
      "pathTemplate": "/reorder/{orderNumber}",
      "params": [
        {
          "key": "orderNumber",
          "label": "Order Number",
          "placeholder": "1000123456",
          "required": true
        }
      ]
    },
    {
      "key": "quotes",
      "label": "Quotes list",
      "description": "Quotes landing",
      "pathTemplate": "/quotes"
    },
    {
      "key": "quote-details",
      "label": "Quote details",
      "description": "Quote details by quote code",
      "pathTemplate": "/quotes/{quoteCode}",
      "params": [
        {
          "key": "quoteCode",
          "label": "Quote Code",
          "placeholder": "Enter the quote code",
          "required": true
        }
      ]
    },
    {
      "key": "lists",
      "label": "Lists",
      "description": "My Lists",
      "pathTemplate": "/my-lists"
    },
    {
      "key": "barcode-scanner",
      "label": "Barcode scanner",
      "description": "Barcode scanner",
      "pathTemplate": "/barcode-scanner"
    },
    {
      "key": "teams",
      "label": "Teams",
      "description": "Team management",
      "pathTemplate": "/teams"
    },
    {
      "key": "cart",
      "label": "Cart",
      "description": "Cart",
      "pathTemplate": "/cart"
    },
    {
      "key": "notifications-messages",
      "label": "Notifications messages",
      "description": "Notifications screen with Messages tab selected",
      "pathTemplate": "/notifications?tab=messages"
    },
    {
      "key": "notifications-inbox",
      "label": "Notifications inbox",
      "description": "Notifications screen with Inbox tab selected",
      "pathTemplate": "/notifications?tab=inbox"
    },
    {
      "key": "plus-dashboard",
      "label": "Loyalty dashboard",
      "description": "Loyalty dashboard",
      "pathTemplate": "/plus-dashboard"
    },
    {
      "key": "plus-dashboard-experiences",
      "label": "Loyalty experiences",
      "description": "Loyalty dashboard with experiences tab selected",
      "pathTemplate": "/plus-dashboard?tab=experiences"
    },
    {
      "key": "plus-dashboard-experience-program",
      "label": "Loyalty experience program",
      "description": "Specific loyalty experience program",
      "pathTemplate": "/plus-dashboard/experience/{programId}/{experienceId}",
      "params": [
        {
          "key": "programId",
          "label": "Program ID",
          "placeholder": "67890",
          "required": true
        },
        {
          "key": "experienceId",
          "label": "Experience ID",
          "placeholder": "12345",
          "required": true
        }
      ]
    },
    {
      "key": "profile",
      "label": "Profile",
      "description": "Profile selection",
      "pathTemplate": "/profile"
    },
    {
      "key": "shop-category",
      "label": "Shop category",
      "description": "Category browsing screen",
      "pathTemplate": "/c/{categoryId}",
      "params": [
        {
          "key": "categoryId",
          "label": "Category ID",
          "placeholder": "hardware",
          "required": true
        }
      ]
    },
    {
      "key": "product-details",
      "label": "Product details",
      "description": "Product details by SKU",
      "pathTemplate": "/p/{sku}",
      "params": [
        {
          "key": "sku",
          "label": "SKU",
          "placeholder": "Enter the product sku",
          "required": true
        }
      ]
    },
    {
      "key": "list-details",
      "label": "List details",
      "description": "Specific list details",
      "pathTemplate": "/my-lists/{listName}",
      "params": [
        {
          "key": "listName",
          "label": "List Name",
          "placeholder": "demo-list",
          "required": true
        }
      ]
    },
    {
      "key": "risk-management-hub-pre-work",
      "label": "Risk management pre-work",
      "description": "Risk management hub pre-work",
      "pathTemplate": "/risk-management-hub/pre-work"
    }
  ]
}
